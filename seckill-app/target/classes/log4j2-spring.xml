<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j2 配置（异步方案：全局异步 All Async）
  ============================================================
  异步通过 log4j2.component.properties 里的
    Log4jContextSelector=org.apache.logging.log4j.core.async.AsyncLoggerContextSelector
  实现，因此这里使用【普通 <Root> / <Logger>】，
  绝对不要改成 <AsyncRoot> / <AsyncLogger>（混用会导致异步嵌套）
  前置依赖：classpath 上必须有 com.lmax:disruptor
  ============================================================
-->
<Configuration status="WARN" monitorInterval="30">

    <!-- ==================== 全局属性 ==================== -->
    <Properties>
        <!-- 日志输出格式（控制台带颜色高亮）— 必须写在一行，多行会把换行和缩进也带进格式里 -->
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight{%-5level} [%thread] %style{%logger{36}}{cyan} - %msg%n</Property>
        <!-- 日志文件输出格式（不带颜色代码，方便日志收集系统解析） -->
        <Property name="LOG_FILE_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</Property>
        <!-- 日志存放路径 -->
        <Property name="LOG_HOME">./logs</Property>
        <!-- 应用名称（用于日志文件名前缀） -->
        <Property name="APP_NAME">seckill</Property>
    </Properties>

    <!-- ==================== Appenders ==================== -->
    <Appenders>

        <!-- 控制台输出 -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <!-- ========== INFO / WARN 级别日志文件（滚动） ========== -->
        <RollingRandomAccessFile name="InfoFile"
                                 fileName="${LOG_HOME}/${APP_NAME}-info.log"
                                 filePattern="${LOG_HOME}/${APP_NAME}-info.%d{yyyy-MM-dd}.%i.log.gz">
            <Filters>
                <!-- 1. 低于 INFO 的（DEBUG / TRACE）直接丢弃 -->
                <ThresholdFilter level="INFO" onMatch="NEUTRAL" onMismatch="DENY"/>
                <!-- 2. ERROR 及以上交给 ErrorFile，这里拒绝 -->
                <ThresholdFilter level="ERROR" onMatch="DENY" onMismatch="ACCEPT"/>
            </Filters>
            <PatternLayout pattern="${LOG_FILE_PATTERN}"/>
            <Policies>
                <!-- 按天滚动 -->
                <TimeBasedTriggeringPolicy interval="1"/>
                <!-- 单个文件最大 50MB -->
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <!-- 默认滚动策略：按天 + 大小双维度，保留 30 天 -->
            <DefaultRolloverStrategy max="30">
                <Delete basePath="${LOG_HOME}" maxDepth="1">
                    <IfFileName glob="${APP_NAME}-info.*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingRandomAccessFile>

        <!-- ========== ERROR 级别日志文件（滚动） ========== -->
        <RollingRandomAccessFile name="ErrorFile"
                                 fileName="${LOG_HOME}/${APP_NAME}-error.log"
                                 filePattern="${LOG_HOME}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz">
            <Filters>
                <!-- 只记录 ERROR 及以上级别 -->
                <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
            <PatternLayout pattern="${LOG_FILE_PATTERN}"/>
            <Policies>
                <!-- 按天滚动 -->
                <TimeBasedTriggeringPolicy interval="1"/>
                <!-- 单个文件最大 50MB -->
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="${LOG_HOME}" maxDepth="1">
                    <IfFileName glob="${APP_NAME}-error.*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingRandomAccessFile>

    </Appenders>

    <!-- ==================== Loggers ==================== -->
    <Loggers>

        <!-- ===== 生产环境：只写文件，不输出到控制台 ===== -->
        <SpringProfile name="prod">
            <Root level="INFO">
                <AppenderRef ref="InfoFile"/>
                <AppenderRef ref="ErrorFile"/>
            </Root>
        </SpringProfile>

        <!-- ===== 其他所有环境（dev / local / test / 未指定）：控制台 + 文件 ===== -->
        <SpringProfile name="!prod">

            <Root level="INFO">
                <AppenderRef ref="Console"/>
                <AppenderRef ref="InfoFile"/>
                <AppenderRef ref="ErrorFile"/>
            </Root>

            <!-- 业务代码：放开到 DEBUG。additivity=false 防止日志重复输出 -->
            <Logger name="com.practice.flashsale" level="DEBUG" additivity="false">
                <AppenderRef ref="Console"/>
                <AppenderRef ref="InfoFile"/>
                <AppenderRef ref="ErrorFile"/>
            </Logger>

            <!-- MyBatis-Plus SQL：压测时把 level 改成 INFO，或整段注释掉 -->
            <Logger name="com.practice.flashsale.common.mapper" level="DEBUG" additivity="false">
                <AppenderRef ref="Console"/>
                <AppenderRef ref="InfoFile"/>
            </Logger>

        </SpringProfile>

    </Loggers>
</Configuration>
